{
  "name": "@youhaozhao/cninfo-mcp",
  "version": "1.4.1",
  "description": "MCP Server for querying and downloading Chinese listed companies' periodic reports from CNINFO (巨潮资讯网)",
  "keywords": [
    "mcp",
    "mcp-server",
    "cninfo",
    "chinese-stock",
    "annual-reports",
    "quarterly-reports",
    "semiannual-reports",
    "periodic-reports",
    "finance",
    "python",
    "巨潮",
    "巨潮资讯",
    "定期报告",
    "年报",
    "半年报",
    "季报",
    "招股书",
    "A股",
    "上市公司",
    "财报"
  ],
  "homepage": "https://github.com/youhaozhao/cninfo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youhaozhao/cninfo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/youhaozhao/cninfo-mcp/issues"
  },
  "license": "MIT",
  "bin": {
    "cninfo-mcp": "bin/cninfo-mcp.js"
  },
  "scripts": {
    "postinstall": "node scripts/install-python-deps.js",
    "start": "node bin/cninfo-mcp.js",
    "dev": "node bin/cninfo-mcp.js",
    "test": "python3 -m pytest python -q && node --test scripts/test-launcher.js"
  },
  "dependencies": {
    "spawn-please": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "bin/",
    "python/mcp_server.py",
    "python/check_deps.py",
    "python/spider.py",
    "python/requirements.txt",
    "scripts/install-python-deps.js",
    "README.md",
    "LICENSE"
  ]
}
