{
  "name": "@youhaozhao/cninfo-mcp",
  "version": "3.0.0",
  "mcpName": "io.github.youhaozhao/cninfo-mcp",
  "description": "MCP server for China-market investment research on CNINFO (巨潮资讯网): announcements, periodic reports, in-report PDF reading, financials, shareholders, dividends and trading disclosures",
  "keywords": [
    "mcp",
    "mcp-server",
    "cninfo",
    "chinese-stock",
    "a-share",
    "annual-reports",
    "announcements",
    "financial-statements",
    "investment-research",
    "finance",
    "巨潮",
    "巨潮资讯",
    "定期报告",
    "年报",
    "公告",
    "财报",
    "A股",
    "上市公司",
    "投研"
  ],
  "homepage": "https://github.com/youhaozhao/cninfo-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youhaozhao/cninfo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/youhaozhao/cninfo-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "cninfo-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:live": "CNINFO_LIVE=1 node --test test/live/live.ts",
    "start": "node dist/cli.js",
    "dev": "node src/cli.ts",
    "prepack": "npm run build",
    "probe": "node src/cli.ts probe"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
